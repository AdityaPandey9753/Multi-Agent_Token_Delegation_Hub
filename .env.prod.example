POSTGRES_USER=openclaw
POSTGRES_PASSWORD=openclaw
POSTGRES_DB=openclaw
POSTGRES_PORT=5432

# Flask
FLASK_ENV=production
FLASK_SECRET=please-change-me

# OpenClaw Gateway (Next.js) reachable from the server container
GATEWAY_CHAT_URL=http://gateway:3001/api/gateway/chat
GATEWAY_TIMEOUT_SECONDS=60

# Ollama (host or sidecar container)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3.5:4b
